With c As (
Select c.ucinn_ascendv2__contact__c
     , listagg(c.ap_degree_type_from_degreecode__c, ', ') Within Group (Order By c.ap_start_date__c ASC) As Deg_Type
     , listagg(c.ap_start_date__c, ', ') Within Group (Order By c.ap_start_date__c ASC) As Deg_Start_Date
     , listagg(c.ap_status__c, ', ') Within Group (Order By c.ap_start_date__c ASC) As Deg_Status
     , listagg(c.ap_school_name_formula__c, ', ') Within Group (Order By c.ap_start_date__c ASC) As Deg_Name
     , listagg(c.ap_campus__c, ', ') Within Group (Order By c.ap_start_date__c ASC) As Deg_Campus
From stg_alumni.ucinn_ascendv2__degree_information__c c
Where (c.ap_status__c In ('Active', 'Deposited', 'Inactive')
Or (c.ap_status__c = 'Discontinued'
And AP_SCHOOL_NAME_FORMULA__C = 'Kellogg'))
Group By c.ucinn_ascendv2__contact__c
)


